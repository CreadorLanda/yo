# Copy to .env and fill in. The .env file is loaded automatically in dev.

APP_ENV=dev
HTTP_ADDR=:8080

# ── Postgres ─────────────────────────────────────────────────────────────────
#
# Use the Supabase TRANSACTION-MODE pooler URL (port 6543), NOT the direct
# 5432 connection — direct connections exhaust quickly.
#
# Get it from: Supabase dashboard → Project Settings → Database
#              → Connection string → URI (under "Connection pooler", "Transaction")
#
# Format:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
POSTGRES_URL=postgresql://postgres.<project>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# Offline-only fallback (uncomment + run `make docker-up-local`):
# POSTGRES_URL=postgres://socialize:socialize@localhost:5432/socialize?sslmode=disable

# ── Redis ────────────────────────────────────────────────────────────────────
#
# Pick ONE source:
#
# A) Upstash (free tier, recommended for early stages) — TCP URL, always TLS:
#    Get it from: console.upstash.com → Database → Connect → "Redis CLI" line
#                 (use the rediss:// form, not the REST URL).
REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379
#
# B) Self-hosted on the same VPS:
# REDIS_URL=redis://localhost:6379/0
#
# C) Local Docker for offline dev (`make docker-up`):
# REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────────────────────────────────────
#
# 32+ bytes of random secret. Generate with:
#   openssl rand -base64 48
#
JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-secret-data
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# Server-only HMAC key for OTP verifiers. Generate with: openssl rand -base64 48
OTP_PEPPER=replace-me-with-a-separate-32-byte-random-secret

# ── Media uploads ────────────────────────────────────────────────────────────
# Local directory for uploaded files (create it if missing). S3/R2 later.
MEDIA_DIR=./data/media
# Max single-file size in bytes (default 25 MiB).
MEDIA_MAX_BYTES=26214400

# ── Push worker ──────────────────────────────────────────────────────────────
# Expo push tokens (ExponentPushToken[...]) are delivered via Expo's API
# automatically — no extra env needed for Expo Go / EAS builds.
#
# Native FCM HTTP v1 (device tokens from getDevicePushTokenAsync / bare):
#
# Point CREDENTIALS_FILE outside the repository — ~/.config/socialize/ locally,
# /opt/socialize/ on the VPS, mode 600. The key grants send access to the
# project's notifications; one that reaches a public repo has to be rotated,
# not deleted.
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CREDENTIALS_FILE=/path/to/service-account.json
# # or inline JSON (e.g. from a secret manager):
# # FCM_CREDENTIALS_JSON={"type":"service_account",...}
#
# Optional HTTP relay that receives {user_id,title,body,data,tokens[]}.
# PUSH_WEBHOOK_URL=https://example.com/hooks/push

# ── Message encryption at rest ──────────────────────────────────────────────
#
# AES-256-GCM key for message content in the database. Must be exactly
# 32 bytes as 64 hex chars. Mint with: openssl rand -hex 32
#
# WARNING: changing this makes every already-stored message undecryptable.
#
MESSAGE_KEY=replace-me-with-an-openssl-rand-hex-32

# ── Chamadas (LiveKit, auto-hospedado) ───────────────────────────────────────
#
# Vazio = chamadas desligadas: o endpoint de token responde 503 em vez de
# entregar um token para uma sala que ninguém alcança.
#
# Gerar as chaves e pôr o SFU de pé: ./scripts/vps-livekit.sh
#
# LIVEKIT_URL=wss://yo.alexandrelanda.com/livekit
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
