# Reverse proxy + automatic TLS (Let's Encrypt) for the ZwoSocial API.
#
# This replaces the Cloudflare Tunnel, and doing so removes a real limitation
# rather than merely swapping one host for another: a tunnel carries HTTP and
# WebSockets, and the calls SFU needs UDP, which is neither. With the domain
# pointing straight at this machine, the media ports work with nothing in the
# way.
#
# Install:
#   sudo apt install caddy        # Debian/Ubuntu
#   # or:  https://caddyserver.com/docs/install
#
# Place at /etc/caddy/Caddyfile, then:
#   sudo systemctl reload caddy
#
# DNS first. Caddy proves ownership over port 80 before it can issue a cert,
# so this record must exist and resolve before the first reload:
#
#   yo.alexandrelanda.com.   A   <public IP of this VPS>
#
# The apex alexandrelanda.com can stay wherever it is — on Vercel or anywhere
# else. A subdomain is an independent record; the two do not compete.

yo.alexandrelanda.com {
	encode gzip zstd

	# ── Calls signalling ────────────────────────────────────────────────
	#
	# Only the WebSocket the clients dial to negotiate a call. The audio and
	# video never come through here: they are UDP, straight to ports
	# 50000-60000 on this machine's public address.
	#
	# handle_path strips the prefix, so /livekit/rtc reaches LiveKit as /rtc,
	# which is the path it actually serves.
	handle_path /livekit/* {
		reverse_proxy 127.0.0.1:7880 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}

	# ── Everything else: the Go API ─────────────────────────────────────
	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}

			# The chat WebSocket is long-lived; the default timeouts would cut
			# it and the client would reconnect every minute.
			transport http {
				read_timeout 3600s
				write_timeout 3600s
			}
		}
	}

	# Security headers — defence in depth on top of TLS.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "interest-cohort=()"
		-Server
	}

	log {
		output file /var/log/caddy/yo.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
