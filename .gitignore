# Dependencies
node_modules/

# Build output
dist/
build/
web-build/

# Expo / React Native
.expo/
expo-env.d.ts
*.tsbuildinfo
.metro-health-check*

# Native projects (generated by prebuild)
#
# Unanchored on purpose — the generated projects can appear under any app in
# the monorepo. The exception below is not optional: a local Expo module keeps
# its Kotlin and Swift in folders with exactly these names, and without it the
# native half of `modules/` is silently absent from every commit.
ios/
android/
!mobile/modules/**/android/
!mobile/modules/**/ios/
!mobile/modules/**

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.p8
*.p12
*.mobileprovision

# Google / Firebase service accounts.
#
# A key like this landed in mobile/ once. It was never committed, but the only
# reason is that nobody ran `git add .` in between. The private key inside
# grants send access to the project's push notifications, and a key that
# reaches a public repository is burnt — rotating it is the only fix.
#
# The real copy lives outside the repository entirely (~/.config/yo/),
# referenced by path from .env. These patterns are the second line of defence,
# for the next time one gets dropped in here by accident.
*-firebase-adminsdk-*.json
*service-account*.json
serviceAccountKey*.json

# Deliberately NOT ignored: google-services.json and GoogleService-Info.plist.
# They ship inside the app bundle, so anyone with the APK already has them —
# ignoring them buys no secrecy and breaks EAS builds, which take the files
# from git. The service-account key above is the opposite: it never leaves a
# server, and it is the one that grants send access.

# Go / Server
server/bin/
server/data/
server/*.out
server/coverage.txt

# Editors / IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# OS files
.DS_Store
Thumbs.db
